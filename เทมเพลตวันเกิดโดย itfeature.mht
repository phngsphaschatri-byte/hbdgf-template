  .left-1 { left: calc(var(--spacing)*1); }
  .left-1\.5 { left: calc(var(--spacing)*1.5); }
  .left-1\/2, .left-2\/4 { left: 50%; }
  .left-3 { left: calc(var(--spacing)*3); }
